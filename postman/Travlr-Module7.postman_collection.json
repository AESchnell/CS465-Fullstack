{
  "info": {
    "name": "Travlr Module Seven Authentication",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Set adminEmail/adminPassword using a local account. Set unique mockEmail, mockPassword (12+ characters), testCode, and a locally generated expiredToken. The supplied runner generates these in memory and cleans up its mock account; do not export secrets."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000"
    },
    {
      "key": "invalidToken",
      "value": "invalid.token.value"
    },
    {
      "key": "websiteUrl",
      "value": "http://127.0.0.1:3000"
    }
  ],
  "item": [
    {
      "name": "Public GET trips",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/trips",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
              "pm.test(\"Public list available\", () => pm.expect(pm.response.json()).to.be.an(\"array\"));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous POST denied",
      "request": {
        "method": "POST",
        "url": "{{baseUrl}}/api/trips",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\": \"{{testCode}}\", \"name\": \"Module Seven Security Test\", \"length\": \"3 nights / 4 days\", \"start\": \"2027-08-12\", \"resort\": \"Security Test Resort\", \"perPerson\": 999, \"image\": \"reef1.jpg\", \"description\": \"<p>Temporary security test trip.</p>\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous PUT denied",
      "request": {
        "method": "PUT",
        "url": "{{baseUrl}}/api/trips/{{testCode}}",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\"code\": \"{{testCode}}\", \"name\": \"Module Seven Security Test\", \"length\": \"3 nights / 4 days\", \"start\": \"2027-08-12\", \"resort\": \"Security Test Resort\", \"perPerson\": 999, \"image\": \"reef1.jpg\", \"description\": \"<p>Temporary security test trip.</p>\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
            ]
          }
        }
      ]
    },
    {
      "name": "Anonymous DELETE denied",
      "request": {
        "method": "DELETE",
        "url": "{{baseUrl}}/api/trips/{{testCode}}",
        "header": []
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP 401\", () => pm.response.to.have.status(401));"
